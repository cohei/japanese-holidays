cabal-version: 3.8
name: japanese-holidays
version: 1.0.0.0
synopsis: Japanese holidays utility
description: Please see README.md
category: Time
homepage: https://github.com/cohei/japanese-holidays#readme
bug-reports: https://github.com/cohei/japanese-holidays/issues
author: TANIGUCHI Kohei
maintainer: a.d.xvii.kal.mai@gmail.com
copyright: 2015 TANIGUCHI Kohei
license: BSD-3-Clause
license-file: LICENSE
extra-source-files:
  README.md

source-repository head
  type: git
  location: https://github.com/cohei/japanese-holidays

common warning
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wmissing-import-lists
    -Wmissing-local-signatures
    -Wmonomorphism-restriction
    -Wpartial-fields
    -Wredundant-constraints

common dependency
  build-depends:
    base >=4.7 && <5,
    time >=1.6,

library
  import: dependency, warning
  hs-source-dirs: src
  exposed-modules:
    Data.Holiday.Japan

test-suite doctest
  import: dependency
  hs-source-dirs: test
  main-is: doctest.hs
  build-depends:
    doctest >=0.8

test-suite hspec
  import: dependency, warning
  hs-source-dirs: test
  main-is: Spec.hs
  other-modules:
    Data.Holiday.JapanSpec

  build-tool-depends:
    hspec-discover:hspec-discover

  build-depends:
    hspec,
    japanese-holidays,
